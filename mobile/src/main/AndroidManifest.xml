<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"></uses-permission>
    <uses-permission android:name="com.google.android.gms.permission.BIND_DATA_LAYER_SERVICE" />
    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_cerverica"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_cerverica_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.CERVERICA"
        tools:targetApi="31"
        android:usesCleartextTraffic="true">
        <receiver android:name=".WearableBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.cerverica.LOGIN_ACTION" />
                <action android:name="com.example.cerverica.LOGOUT_ACTION" />
            </intent-filter>
        </receiver>
        <service android:name=".MobileWearableService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/prefix" />
            </intent-filter>
        </service>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- LoginActivity -->
        <activity android:name=".LoginActivity" />

        <!-- RegistroActivity -->
        <activity android:name=".controllers.RegistroActivity" />

        <!-- AdminActivity -->
        <activity android:name=".controllers.admin.AdminActivity" />

        <!-- EmpleadoActivity -->
        <activity android:name=".controllers.empleado.EmpleadoActivity" />

        <!-- ClienteActivity -->
        <activity android:name=".controllers.cliente.ClienteActivity" />
        <activity android:name=".controllers.cliente.ClienteFavoritosActivity" />
    </application>

</manifest>